---
/* Navigation minimale pour la page vitrine. */
---
<header class="header">
  <div class="conteneur header__inner">
    <a href="/#accueil" class="header__logo" aria-label="Sefacile PC — Retour en haut">
      <img src="/logo.svg" alt="Sefacile PC" width="160" height="70" />
    </a>
    <a href="/#contact" class="btn-principal">Demander un devis</a>
  </div>
</header>
<style>
  .header{position:sticky;top:0;z-index:100;background:rgba(10,10,10,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--couleur-bordure)}
  .header__inner{min-height:80px;display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .header__logo img{display:block;width:160px;max-width:45vw;height:70px;object-fit:contain}
  .header .btn-principal{white-space:nowrap;text-align:center}
  @media(max-width:480px){.header__inner{min-height:68px}.header__logo img{width:115px;height:58px}.header .btn-principal{font-size:.8rem;padding:.7rem .8rem}}
</style>
