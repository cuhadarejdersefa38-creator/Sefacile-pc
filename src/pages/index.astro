---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Montage PC Gaming Isère | Sefacile PC" description="Sefacile PC à Corbelin en Isère : montage de PC Gaming et Workstation 3D sur mesure.">
  <main>
    <section id="accueil" class="hero" aria-label="Introduction">
      <div class="conteneur hero__inner">

        <div class="hero__contenu">
          <h1 class="hero__titre">
            Votre PC sur mesure
          </h1>

          <p class="hero__sous-titre">
            Un PC adapté à vos jeux, à vos besoins et à votre budget.
            Je vous conseille sur les composants, vous les achetez,
            puis je monte et teste votre ordinateur.
          </p>
          <p class="hero__tarif"><strong>Montage à 150 €</strong><span> — composants non compris</span></p>
          <a class="hero__contact" href="https://wa.me/33683500125" target="_blank" rel="noopener noreferrer">Parler de mon projet</a>

        </div>


      </div>


    </section>
    <section class="prestations" aria-labelledby="prestations-titre">
      <div class="conteneur">
        <h2 id="prestations-titre">Ce qui est inclus pour <span>150 €</span></h2>
        <ul class="prestations__liste">
          <li><span class="prestations__numero" aria-hidden="true">01</span><h3>Montage complet du PC</h3><p>Assemblage des composants et rangement soigné des câbles.</p></li>
          <li><span class="prestations__numero" aria-hidden="true">02</span><h3>Installation d’un OS</h3><p>Installation du système d’exploitation de votre choix et des pilotes adaptés.</p></li>
          <li><span class="prestations__numero" aria-hidden="true">03</span><h3>Mises à jour système et BIOS</h3><p>Mise à jour du système d’exploitation et du BIOS de la carte mère.</p></li>
          <li><span class="prestations__numero" aria-hidden="true">04</span><h3>Test OCCT</h3><p>Test de stabilité du PC et contrôle des températures avec OCCT.</p></li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
<style>
  .hero{display:flex;align-items:center;padding:5rem 0 2rem;background:#101214;color:#f5f5f5}
  .hero__inner{width:100%}
  .hero__titre{color:#40e0d0;font-size:clamp(2.2rem,6vw,4rem);line-height:1.1;margin-bottom:1.25rem;letter-spacing:-.02em}
  .hero__sous-titre{color:#b8b8b8;font-size:clamp(1rem,2vw,1.15rem);max-width:52ch;margin-bottom:2rem;line-height:1.7}
  .hero__contenu{max-width:780px;margin-inline:auto;text-align:center}
  .hero__sous-titre{margin-inline:auto}
  .hero__tarif{font-size:1rem;margin-bottom:1.5rem;color:#b8b8b8}
  .hero__tarif strong{color:#f5f5f5}
  .hero__contact{display:inline-flex;align-items:center;justify-content:center;padding:.9rem 1.6rem;border-radius:8px;background:#40e0d0;color:#101214;font-weight:700;line-height:1.4;transition:background-color .15s}
  .hero__contact:hover{background:#78eadf}
  .hero__contact:focus-visible{outline:3px solid #f5f5f5;outline-offset:5px}
  @media(max-width:420px){.hero__tarif span{display:block;margin-top:.3rem}}
  .prestations{padding:1.5rem 0 5rem;background:#101214}
  .prestations h2{text-align:center;font-size:clamp(1.6rem,4vw,2.4rem);margin-bottom:2.5rem;letter-spacing:-.02em}
  .prestations h2 span,.prestations__numero{color:#40e0d0}
  .prestations__liste{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.25rem}
  .prestations__liste li{padding:1.5rem;background:#191c1e;border:1px solid #303638;border-radius:10px}
  .prestations__numero{display:block;font-weight:700;font-size:.85rem;margin-bottom:1.3rem}
  .prestations h3{font-size:1.1rem;line-height:1.35;margin-bottom:.75rem}
  .prestations__liste p{font-size:.95rem;color:#b8b8b8;line-height:1.65}
  @media(max-width:900px){.prestations__liste{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:550px){.prestations{padding:1rem 0 3rem}.prestations__liste{grid-template-columns:1fr}}
</style>
